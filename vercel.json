{
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    {
      "source": "/store",
      "destination": "/"
    },
    {
      "source": "/login",
      "destination": "/"
    },
    {
      "source": "/signup",
      "destination": "/"
    },
    {
      "source": "/sell",
      "destination": "/"
    },
    {
      "source": "/help",
      "destination": "/"
    },
    {
      "source": "/account",
      "destination": "/"
    },
    {
      "source": "/account/:path*",
      "destination": "/"
    },
    {
      "source": "/vendor",
      "destination": "/"
    },
    {
      "source": "/vendor/:path*",
      "destination": "/"
    },
    {
      "source": "/admin",
      "destination": "/"
    },
    {
      "source": "/admin/:path*",
      "destination": "/"
    },
    {
      "source": "/case",
      "destination": "/"
    },
    {
      "source": "/case/:path*",
      "destination": "/"
    },
    {
      "source": "/listing/:id",
      "destination": "/"
    },
    {
      "source": "/seller/:id",
      "destination": "/"
    },
    {
      "source": "/s/:slug",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/staff",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    },
    {
      "source": "/staff.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        }
      ]
    }
  ]
}
